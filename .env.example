# PostgreSQL connection string for the Neon database.
# Never commit a real value. Copy this to .env.local and fill in your own.
DATABASE_URL=postgres://user:password@host.neon.tech/dbname

# NextAuth secret (required). Generate with: openssl rand -base64 32
# AUTH_SECRET=your-secret-here

# Superadmin credentials (env-based, no DB row). Leave unset to disable.
# SUPERADMIN_EMAIL=admin@example.com
# SUPERADMIN_PASSWORD=changeme

# Enable the POST /api/admin/reset endpoint (truncates ALL data).
# ALLOW_DB_RESET=true